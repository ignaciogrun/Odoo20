<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rugby_team_view_list" model="ir.ui.view">
        <field name="name">rugby.team.list</field>
        <field name="model">rugby.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_url" string="Page" optional="show"/>
                <field name="website_menu_parent_id" optional="show"/>
                <field name="is_published" string="On Website" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="rugby_team_view_form" model="ir.ui.view">
        <field name="name">rugby.team.form</field>
        <field name="model">rugby.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mens A"/></h1>
                    </div>
                    <group string="Website Page">
                        <field name="is_published" string="Published" widget="boolean_toggle"/>
                        <label for="website_slug"/>
                        <div class="d-flex align-items-baseline">
                            <span class="text-muted">/schedule/</span>
                            <field name="website_slug" placeholder="mens-a"/>
                        </div>
                        <field name="website_menu_parent_id" placeholder="e.g. Schedule &amp; Results"
                            options="{'no_create': True}"/>
                    </group>
                    <group string="Events">
                        <field name="event_tag_id" string="Event Tag" readonly="1"/>
                    </group>
                    <div class="text-muted small">
                        The page shows this team's results: played matches with "Show Result on Website"
                        turned on. For upcoming games, open the page (Go to Website, then Edit) and drop an
                        Event block into the area above the results, filtered by the Event Tag shown here.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rugby_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">rugby.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the club's teams</p>
            <p>For example Mens A, Mens B, Women and Youth. Every season belongs to a team, and each
                team can have its own Schedule &amp; Results page on the website.</p>
        </field>
    </record>
</odoo>
