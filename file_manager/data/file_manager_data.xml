<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="folder_shared" model="file.manager.folder">
            <field name="name">Shared</field>
            <field name="access_mode">edit</field>
            <field name="owner_id" ref="base.user_admin"/>
        </record>

        <record id="ir_cron_purge_trash" model="ir.cron" forcecreate="True">
            <field name="name">Files: Empty Old Trash</field>
            <field name="model_id" ref="model_file_manager_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_trash()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="config_trash_days" model="ir.config_parameter">
            <field name="key">file_manager.trash_days</field>
            <field name="value">30</field>
        </record>
    </data>
</odoo>
