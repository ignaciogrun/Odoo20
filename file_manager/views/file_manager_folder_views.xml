<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_file_manager_folder_form" model="ir.ui.view">
        <field name="name">file.manager.folder.form</field>
        <field name="model">file.manager.folder</field>
        <field name="arch" type="xml">
            <form string="Folder">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Contracts"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="description" placeholder="What is this folder for?"/>
                        </group>
                    </group>
                    <group string="Who has access">
                        <field name="inherit_access" invisible="not parent_id"/>
                        <field name="owner_id" invisible="inherit_access" required="not inherit_access"/>
                        <field name="access_mode" widget="radio" invisible="inherit_access"/>
                        <field name="editor_ids" widget="many2many_tags" invisible="inherit_access"
                            options="{'no_create': True}"/>
                        <field name="viewer_ids" widget="many2many_tags" invisible="inherit_access"
                            options="{'no_create': True}"/>
                        <field name="effective_owner_id" string="Owner" readonly="1" invisible="not inherit_access"/>
                        <field name="effective_access_mode" string="Internal Users" readonly="1" invisible="not inherit_access"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_file_manager_folder_list" model="ir.ui.view">
        <field name="name">file.manager.folder.list</field>
        <field name="model">file.manager.folder</field>
        <field name="arch" type="xml">
            <list string="Folders">
                <field name="complete_name"/>
                <field name="effective_owner_id" string="Owner"/>
                <field name="effective_access_mode" string="Access"/>
            </list>
        </field>
    </record>

    <record id="action_file_manager_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">file.manager.folder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
