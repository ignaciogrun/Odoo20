<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_file_manager_tag_list" model="ir.ui.view">
        <field name="name">file.manager.tag.list</field>
        <field name="model">file.manager.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_file_manager_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">file.manager.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
