<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_file_manager" model="res.groups.privilege">
        <field name="name">Files</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_file_manager_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can see and manage every folder, file and share link.</field>
        <field name="privilege_id" ref="res_groups_privilege_file_manager"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
