<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_view_kanban" model="ir.ui.view">
        <field name="name">warranty.warranty.kanban</field>
        <field name="model">warranty.warranty</field>
        <field name="arch" type="xml">
            <!-- The column comes from the dates, so cards can't be dragged
                 between columns and columns can't be added or renamed. -->
            <kanban default_group_by="state" default_order="expiration_date"
                    records_draggable="false" group_create="false" group_delete="false"
                    group_edit="false" quick_create="false" sample="1">
                <field name="state"/>
                <field name="days_left"/>
                <progressbar field="state"
                    colors='{"in_progress": "success", "expiring": "warning", "expired": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="flex-grow-1 overflow-hidden">
                                <field name="name" class="fw-bold fs-5 d-block text-truncate"/>
                                <field name="place_of_purchase" class="text-muted d-block text-truncate"/>
                                <div class="small mt-1">
                                    Expires <field name="expiration_date"/>
                                </div>
                            </div>
                            <field t-if="record.receipt_image_128.raw_value" name="receipt_image_128"
                                widget="image" class="ms-2 flex-shrink-0"
                                options="{'size': [56, 56], 'img_class': 'object-fit-cover rounded border'}"/>
                        </div>
                        <footer class="pt-2">
                            <field name="holder_id" widget="many2one_avatar"/>
                            <t t-set="days" t-value="record.days_left.raw_value"/>
                            <span t-attf-class="ms-auto badge rounded-pill #{
                                record.state.raw_value === 'expired' ? 'text-bg-danger'
                                : record.state.raw_value === 'expiring' ? 'text-bg-warning' : 'text-bg-success'}">
                                <t t-if="days &lt; -1">Expired <t t-out="-days"/> days ago</t>
                                <t t-elif="days === -1">Expired yesterday</t>
                                <t t-elif="days === 0">Expires today</t>
                                <t t-elif="days === 1">1 day left</t>
                                <t t-else=""><t t-out="days"/> days left</t>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="warranty_view_list" model="ir.ui.view">
        <field name="name">warranty.warranty.list</field>
        <field name="model">warranty.warranty</field>
        <field name="arch" type="xml">
            <list default_order="expiration_date"
                  decoration-muted="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="holder_id" widget="many2one_avatar"/>
                <field name="place_of_purchase" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="expiration_date"/>
                <field name="days_left" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'in_progress'"
                    decoration-warning="state == 'expiring'"
                    decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="warranty_view_form" model="ir.ui.view">
        <field name="name">warranty.warranty.form</field>
        <field name="model">warranty.warranty</field>
        <field name="arch" type="xml">
            <form string="Warranty">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="not active or state != 'expired'"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Refrigerator"/></h1>
                    </div>
                    <group>
                        <group string="Coverage">
                            <field name="start_date"/>
                            <field name="expiration_date"/>
                            <field name="days_left" string="Days Left" invisible="not expiration_date or state == 'expired'"/>
                        </group>
                        <group string="Purchase">
                            <field name="place_of_purchase" placeholder="e.g. Best Buy, Kissimmee"/>
                            <field name="holder_id" widget="many2one_avatar"/>
                        </group>
                    </group>
                    <group>
                        <group string="File a Claim">
                            <field name="claim_link" nolabel="1" colspan="2"
                                placeholder="Paste the link to the claim page, and any notes such as the serial number or phone number"/>
                        </group>
                        <group string="Receipt">
                            <field name="receipt_image" nolabel="1" colspan="2" widget="image"
                                options="{'size': [0, 320], 'zoom': true, 'img_class': 'object-fit-contain'}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_view_search" model="ir.ui.view">
        <field name="name">warranty.warranty.search</field>
        <field name="model">warranty.warranty</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="holder_id"/>
                <field name="place_of_purchase"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="expiring" string="Expiring in 30 Days" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_holder" string="Warranty Holder" context="{'group_by': 'holder_id'}"/>
                <filter name="group_expiration" string="Expiration Month" context="{'group_by': 'expiration_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_warranty" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">warranty.warranty</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">warranties</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first warranty</p>
            <p>Keep the receipt, the dates and the claim link together. Warranties move
                to "Expiring in 30 Days" and then "Expired" on their own as the days pass.</p>
        </field>
    </record>
</odoo>
