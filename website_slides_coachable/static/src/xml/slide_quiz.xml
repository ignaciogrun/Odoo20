<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- The full-screen player draws the quiz in the browser instead of on the server. -->
    <t t-inherit="slide.slide.quiz" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('h4')]" position="after">
            <div t-if="question.coachable_url" class="o_wslides_coachable_frame">
                <iframe t-att-src="question.coachable_url" title="Play animation" tabindex="-1"
                    scrolling="no" loading="lazy" referrerpolicy="no-referrer"
                    sandbox="allow-scripts allow-same-origin"/>
            </div>
        </xpath>
    </t>

    <!-- Odoo 20 finds this by name, from the video source of the lesson. Odoo 19
         uses its generic video template instead, and ignores this one. -->
    <t t-name="website.slides.fullscreen.video.coachable">
        <div class="player ratio ratio-16x9 embed-responsive-item h-100">
            <iframe t-att-src="slide.embedUrl" title="Play animation" allowFullScreen="true" frameborder="0"/>
        </div>
    </t>
</templates>
