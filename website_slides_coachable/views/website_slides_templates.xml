<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lesson_content_quiz_question" inherit_id="website_slides.lesson_content_quiz_question">
        <xpath expr="//div[@t-att-data-question-id]/div[hasclass('row')]" position="after">
            <div t-if="question['coachable_url']" class="o_wslides_coachable_frame">
                <iframe t-att-src="question['coachable_url']" title="Play animation" tabindex="-1"
                    scrolling="no" loading="lazy" referrerpolicy="no-referrer"
                    sandbox="allow-scripts allow-same-origin"/>
            </div>
        </xpath>
    </template>

    <template id="player_page" name="Coachable: cropped play player">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Play animation</title>
                <link rel="stylesheet" href="/website_slides_coachable/static/player/player.css"/>
            </head>
            <body>
                <div id="field">
                    <iframe id="play" t-att-src="play_url" title="Play animation" tabindex="-1"
                        scrolling="no" referrerpolicy="no-referrer"
                        sandbox="allow-scripts allow-same-origin"/>
                </div>
                <script src="/website_slides_coachable/static/player/player.js"/>
            </body>
        </html>
    </template>
</odoo>
